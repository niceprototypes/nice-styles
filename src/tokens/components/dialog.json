{
  "backgroundColor": {
    "base": "var(--np--background-color--raised)"
  },
  "color": {
    "base": "var(--np--color)"
  },
  "borderRadius": {
    "base": "var(--np--border-radius)"
  },
  "boxShadow": {
    "base": "var(--np--box-shadow--large)"
  },
  "width": {
    "base": "fit-content"
  },
  "maxWidth": {
    "base": "calc(100% - 6px - 2em)"
  },
  "padding": {
    "base": "var(--np--gap)"
  },
  "gap": {
    "base": "var(--np--gap)"
  },
  "backdrop": {
    "backgroundColor": {
      "base": "rgba(0, 0, 0, 0.1)"
    }
  },
  "title": {
    "fontSize": {
      "base": "var(--np--font-size--large)"
    },
    "fontWeight": {
      "base": "var(--np--font-weight--semibold)"
    }
  },
  "description": {
    "color": {
      "base": "var(--np--color--light)"
    }
  },
  "actions": {
    "gap": {
      "base": "var(--np--gap--small)"
    }
  },
  "$themes": {
    "night": {}
  }
}
